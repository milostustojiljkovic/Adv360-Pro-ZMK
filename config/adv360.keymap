#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_cmd_combo {
            bindings = <&kp LEFT_COMMAND>;
            key-positions = <31 30>;
            timeout-ms = <28>;
        };

        right_cmd_combo {
            bindings = <&kp RIGHT_COMMAND>;
            key-positions = <42 43>;
            timeout-ms = <28>;
        };

        left_control_combo {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <48 49>;
            timeout-ms = <28>;
        };

        right_control_combo {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <56 57>;
            timeout-ms = <28>;
        };

        left_home {
            bindings = <&kp HOME>;
            key-positions = <31 32>;
            timeout-ms = <28>;
        };

        right_home {
            bindings = <&kp HOME>;
            key-positions = <41 42>;
            timeout-ms = <28>;
        };

        left_opt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <32 30>;
        };

        right_opt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <41 43>;
        };

        left_layer_2 {
            bindings = <&mo 2>;
            key-positions = <18 17>;
            timeout-ms = <28>;
        };

        right_layer_2 {
            bindings = <&mo 2>;
            key-positions = <23 24>;
            timeout-ms = <28>;
        };

        left_end {
            bindings = <&kp END>;
            key-positions = <17 16>;
            timeout-ms = <28>;
        };

        right_end {
            bindings = <&kp END>;
            key-positions = <24 25>;
            timeout-ms = <28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp NUBS    &kp N1    &kp N2        &kp N3    &kp N4     &kp N5  &tog 1                                                  &mo 3      &kp N6  &kp N7          &kp N8        &kp N9    &kp N0    &kp MINUS
&kp TAB     &kp Q     &kp W         &kp E     &kp R      &kp T   &none                                                   &none      &kp Y   &kp U           &kp I         &kp O     &kp P     &kp EQUAL
&kp ESCAPE  &kp A     &kp S         &kp D     &kp F      &kp G   &none       &none          &none      &none  &none      &none      &kp H   &kp J           &kp K         &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z     &kp X         &kp C     &kp V      &kp B                              &none      &none                        &kp N   &kp M           &kp COMMA     &kp DOT   &kp FSLH  &kp RSHFT
&none       &kp BSLH  &kp CAPSLOCK  &kp LEFT  &kp RIGHT          &kp RETURN  &kp BACKSPACE  &none      &none  &kp ENTER  &kp SPACE          &kp DOWN_ARROW  &kp UP_ARROW  &kp LBKT  &kp RBKT  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2        &kp F3            &kp F4          &kp F5                &kp F6       &tog 1                                      &mo 3   &kp F7        &kp F8                 &kp F9           &kp F10            &kp F11  &kp F12
&trans  &kp EXCL      &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp PERCENT  &none                                       &none   &kp CARET     &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans   &trans
&trans  &kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3    &kp NUMBER_4          &kp N5       &none   &trans  &trans      &trans  &trans  &none   &kp NUMBER_6  &kp N7                 &kp NUMBER_8     &kp N9             &kp N0   &trans
&trans  &kp EXCL      &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp PERCENT                  &trans      &trans                  &kp CARET     &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans   &trans
&trans  &trans        &trans            &trans          &trans                             &trans  &trans  &trans      &trans  &trans  &trans                &trans                 &trans           &trans             &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_DEC  &bl BL_INC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
